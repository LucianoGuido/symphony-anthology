    "schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Symphony Anthology Component Schema",
      "description": "JSON Schema for Symphony Anthology components, enabling AI-powered code generation",
      "version": "0.1.0",
      "definitions": {
        "variantButton": {
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "success",
            "warning",
            "danger",
            "outline",
            "ghost",
            "link"
          ],
          "description": "Button visual variant"
        },
        "variantCard": {
          "type": "string",
          "enum": [
            "default",
            "outlined",
            "glass"
          ],
          "description": "Card visual variant"
        },
        "size": {
          "type": "string",
          "enum": [
            "xs",
            "sm",
            "md",
            "lg",
            "xl"
          ],
          "description": "Component size"
        },
        "elevation": {
          "type": "string",
          "enum": [
            "flat",
            "raised",
            "floating"
          ],
          "description": "Shadow/elevation level"
        },
        "spacing": {
          "type": "string",
          "enum": [
            "3xs",
            "2xs",
            "xs",
            "sm",
            "md",
            "lg",
            "xl",
            "2xl",
            "3xl",
            "4xl",
            "5xl"
          ],
          "description": "Spacing scale value"
        }
      },
      "components": {
        "button": {
          "description": "Interactive button element",
          "element": "button",
          "baseClass": null,
          "attributes": {
            "data-variant": {
              "$ref": "#/definitions/variantButton"
            },
            "data-size": {
              "$ref": "#/definitions/size"
            },
            "data-shape": {
              "type": "string",
              "enum": [
                "default",
                "pill",
                "square"
              ],
              "description": "Button shape"
            }
          },
          "states": {
            "disabled": {
              "type": "boolean",
              "attribute": "disabled"
            },
            "loading": {
              "type": "boolean",
              "attribute": "aria-busy"
            }
          },
          "examples": [
            "<button>Default</button>",
            "<button data-variant=\"primary\">Primary</button>",
            "<button data-variant=\"danger\" data-size=\"lg\">Delete</button>"
          ]
        },
        "card": {
          "description": "Content container with optional header/footer",
          "element": "article",
          "baseClass": "card",
          "attributes": {
            "data-variant": {
              "$ref": "#/definitions/variantCard"
            },
            "data-elevation": {
              "$ref": "#/definitions/elevation"
            },
            "data-layout": {
              "type": "string",
              "enum": [
                "vertical",
                "horizontal"
              ],
              "description": "Card content direction"
            }
          },
          "children": {
            "header": {
              "element": "header",
              "optional": true
            },
            "body": {
              "element": "div",
              "class": "card-body",
              "optional": true
            },
            "footer": {
              "element": "footer",
              "optional": true
            },
            "image": {
              "element": "img",
              "optional": true
            }
          },
          "examples": [
            "<article class=\"card\"><h3>Title</h3><p>Content</p></article>",
            "<article class=\"card\" data-elevation=\"floating\"><header>Header</header><p>Body</p></article>"
          ]
        },
        "dialog": {
          "description": "Modal dialog or drawer",
          "element": "dialog",
          "baseClass": null,
          "attributes": {
            "data-size": {
              "$ref": "#/definitions/size"
            },
            "data-drawer": {
              "type": "string",
              "enum": [
                "right",
                "left",
                "bottom"
              ],
              "description": "Slide-in drawer position"
            },
            "data-type": {
              "type": "string",
              "enum": [
                "default",
                "alert",
                "confirm"
              ],
              "description": "Dialog type"
            }
          },
          "methods": {
            "open": "element.showModal()",
            "close": "element.close()"
          },
          "examples": [
            "<dialog><p>Content</p></dialog>",
            "<dialog data-size=\"lg\" data-drawer=\"right\">Drawer content</dialog>"
          ]
        },
        "accordion": {
          "description": "Expandable content sections",
          "element": "details",
          "baseClass": null,
          "groupClass": "accordion",
          "attributes": {
            "data-variant": {
              "type": "string",
              "enum": [
                "default",
                "flush",
                "card",
                "filled"
              ]
            },
            "data-size": {
              "$ref": "#/definitions/size"
            },
            "data-indicator": {
              "type": "string",
              "enum": [
                "chevron",
                "plus",
                "none"
              ]
            }
          },
          "children": {
            "summary": {
              "element": "summary",
              "required": true
            },
            "content": {
              "description": "Any content after summary"
            }
          },
          "examples": [
            "<details><summary>Title</summary><p>Content</p></details>",
            "<div class=\"accordion\"><details><summary>Q1</summary><p>A1</p></details></div>"
          ]
        },
        "navigation": {
          "description": "Navigation menu",
          "element": "nav",
          "baseClass": null,
          "attributes": {
            "data-direction": {
              "type": "string",
              "enum": [
                "horizontal",
                "vertical"
              ]
            },
            "data-style": {
              "type": "string",
              "enum": [
                "default",
                "pills",
                "underline"
              ]
            },
            "aria-label": {
              "type": "string",
              "description": "Accessible label for the navigation"
            }
          },
          "children": {
            "list": {
              "element": "ul",
              "required": true
            },
            "items": {
              "element": "li",
              "multiple": true
            },
            "links": {
              "element": "a",
              "multiple": true
            }
          },
          "specialTypes": {
            "breadcrumb": {
              "aria-label": "Breadcrumb"
            },
            "pagination": {
              "aria-label": "Pagination"
            }
          },
          "examples": [
            "<nav><ul><li><a href=\"/\">Home</a></li></ul></nav>",
